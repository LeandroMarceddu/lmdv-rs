+#[test]
+fn unsupported_sources_have_no_document() {
+    assert!(render_svg("", &DiagramStyle::neutral(false)).is_none());
+    assert!(render_svg("not a diagram ->", &DiagramStyle::neutral(false)).is_none());
+}
