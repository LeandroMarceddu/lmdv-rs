+impl<S: 'static> Runtime<S> {
+    /// The native close-request gate: runs the app's `on_close_request` while the window still
+    /// shows, before anything is hidden, and says whether it vetoes the close. The native host
+    /// calls this for a `WindowEvent::CloseRequested`; programmatic closes
+    /// (`Tx::close_window`, `AppHandle::close`, `WindowHandle::close`, quitting) never do.
+    ///
+    /// Public for headless tests, which can't drive a window manager's close: pass the hook
+    /// `AppHandle::close_request_hook` reads back. True keeps the window open, its state and
+    /// focus as they were, and runs no `on_close`.
+    #[doc(hidden)]
+    pub fn close_request(&mut self, hook: Option<fn(&mut S, &mut Tx) -> bool>) -> bool {
+        let Some(f) = hook else { return false };
+        let mut veto = false;
+        self.update(|s, tx| veto = f(s, tx));
+        veto
+    }
+}
