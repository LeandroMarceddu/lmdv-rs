{
  "app-id": "md.lmdv",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "lmdv",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home:ro"
  ],
  "modules": [
    {
      "name": "lmdv",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "mkdir -p .cargo",
        "cp -f cargo/config.toml .cargo/config.toml",
        "cargo --offline fetch --locked",
        "cargo --offline build --release --locked -p lmdv",
        "install -Dm755 target/release/lmdv /app/bin/lmdv",
        "install -Dm644 packaging/lmdv.desktop /app/share/applications/md.lmdv.desktop",
        "sed -i -e 's/^Icon=lmdv$/Icon=md.lmdv/' -e '/^TryExec=/d' /app/share/applications/md.lmdv.desktop",
        "install -Dm644 assets/lmdv.svg /app/share/icons/hicolor/scalable/apps/md.lmdv.svg",
        "install -Dm644 assets/lmdv.svg /app/share/icons/hicolor/scalable/apps/lmdv.svg",
        "install -Dm644 packaging/lmdv.xml /app/share/mime/packages/md.lmdv.xml",
        "install -Dm644 packaging/lmdv.metainfo.xml /app/share/metainfo/md.lmdv.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "target",
            "dist"
          ]
        },
        {
          "type": "file",
          "path": "cargo-sources.json"
        }
      ]
    }
  ]
}
